{
  "name": "vibe",
  "private": true,
  "version": "0.0.0",
  "description": "VIBE — More than a match. Real chemistry.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "api:dev": "npm run dev --workspace @vibe/api",
    "mobile:start": "npm run start --workspace @vibe/mobile",
    "db:migrate": "npm run db:migrate --workspace @vibe/api",
    "db:seed": "npm run db:seed --workspace @vibe/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@vibe/config/prettier",
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
