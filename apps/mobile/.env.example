# Kopyala: cp .env.example .env
# EXPO_PUBLIC_ ile başlayan değerler uygulama paketine gömülür ve herkes tarafından okunabilir.
# Buraya asla gizli anahtar yazmayın.

# API adresi (sonunda / olmadan, /api/v1 dahil değil).
#   iOS simülatörü / web: http://localhost:3000
#   Android emülatörü:    http://10.0.2.2:3000
#   Fiziksel cihaz:        http://<bilgisayarın-LAN-IP'si>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
