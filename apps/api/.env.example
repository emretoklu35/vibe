# Kopyala: cp .env.example .env  (yerel geliştirme; değerler infra/docker-compose.yml ile eşleşir)

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

DATABASE_URL=postgresql://vibe:vibe_local_dev@localhost:55432/vibe
REDIS_URL=redis://localhost:56379/0

# Swagger UI: /api/docs. Production'da açılamaz (uygulama başlamaz).
SWAGGER_ENABLED=true

# ─── Gizli anahtarlar ───────────────────────────────────────────────
# Aşağıdakiler YALNIZCA geliştirme anahtarlarıdır ("dev-only" önekli); production'da uygulama başlamaz.
# Gerçek ortamlar için üretin:  openssl rand -base64 32   (JWT için 48 de olabilir)
PHONE_HMAC_KEY=ZGV2LW9ubHktcGhvbmUtaG1hY4+WnaSrsrnAx87V3OM=
PHONE_ENCRYPTION_KEY=ZGV2LW9ubHktcGhvbmUtZW5jIY+WnaSrsrnAx87V3OM=
JWT_ACCESS_SECRET=ZGV2LW9ubHktand0LWFjY2Vzc4+WnaSrsrnAx87V3OPq8fj/Bg0UGyIpMDc+RUxT
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMS: şimdilik yalnızca `console` (doğrulama kodu API loguna yazılır; production'da yasak).
SMS_PROVIDER=console

# ─── Nesne depolama (S3 uyumlu) ─────────────────────────────────────
# Yerelde infra/docker-compose.yml içindeki SeaweedFS. Android emülatöründe S3_PUBLIC_ENDPOINT=http://10.0.2.2:58333
S3_ENDPOINT=http://localhost:58333
S3_PUBLIC_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_BUCKET=vibe-media
S3_ACCESS_KEY_ID=vibe_local
S3_SECRET_ACCESS_KEY=vibe_local_secret_key
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Fotoğraf denetimi: şimdilik yalnızca `dev-auto-approve` (production'da yasak).
MODERATION_PROVIDER=dev-auto-approve

# Bu sürümün altındaki mobil uygulamalar güncellemeye zorlanır.
APP_MIN_VERSION=0.1.0

# Önündeki güvenilir proxy sayısı (load balancer arkasında 1). Yanlış değer IP sahteciliğine açar.
TRUST_PROXY_HOPS=0
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Tarayıcı erişimi (virgülle ayrılmış). Expo web önizlemesi: http://localhost:8081. Boş = CORS kapalı.
CORS_ORIGINS=http://localhost:8081

# E2E testleri (npm run test:e2e) ayrı veritabanı ve Redis DB'si kullanır.
TEST_DATABASE_URL=postgresql://vibe:vibe_local_dev@localhost:55432/vibe_test
TEST_REDIS_URL=redis://localhost:56379/1
