// VIBE veritabanı şeması. Tasarım taslağı: docs/04-schema.prisma.
// Modeller ilgili fazda eklenir; Prisma'nın ifade edemediği kısıtlar (CHECK, PostGIS, GIST)
// migration dosyalarına ham SQL olarak yazılır.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// İlgi alanı kataloğu. Kullanımdaki bir öğe silinmez, isActive=false yapılır.
model Interest {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  category String
  labelTr  String
  labelEn  String
  isActive Boolean @default(true)

  users UserInterest[]

  @@index([category])
}

// ─── Faz 2: hesap, oturum, rıza ───────────────────────────────

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETION_PENDING
}

enum ConsentType {
  PRIVACY_NOTICE_ACK
  TERMS_OF_SERVICE
  SPECIAL_CATEGORY_ORIENTATION
  CROSS_BORDER_TRANSFER
  PRECISE_LOCATION
  MARKETING_NOTIFICATIONS
}

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

/// Hesap. Düz telefon numarası, ad-soyad, e-posta tutulmaz.
model User {
  id                  String        @id @default(uuid()) @db.Uuid
  /// HMAC-SHA256(E.164, PHONE_HMAC_KEY) — arama ve tekillik için
  phoneHash           String        @unique
  /// AES-256-GCM (sürüm baytı + IV + etiket + şifreli metin) — yalnızca SMS göndermek için çözülür
  phoneEncrypted      Bytes
  /// Onboarding'de bir kez girilir; profilde yalnızca yaş gösterilir
  birthDate           DateTime?     @db.Date
  status              AccountStatus @default(ACTIVE)
  suspendedUntil      DateTime?
  deletionRequestedAt DateTime?
  lastActiveAt        DateTime      @default(now())
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  sessions                 Session[]
  consents                 ConsentRecord[]
  dataRequests             DataRequest[]
  profile                  Profile?
  photos                   ProfilePhoto[]
  interests                UserInterest[]
  preference               Preference?
  likesGiven               Like[]                    @relation("LikeActor")
  likesReceived            Like[]                    @relation("LikeTarget")
  passesGiven              Pass[]                    @relation("PassActor")
  passesReceived           Pass[]                    @relation("PassTarget")
  matchesAsA               Match[]                   @relation("MatchUserA")
  matchesAsB               Match[]                   @relation("MatchUserB")
  blocksGiven              Block[]                   @relation("BlockBlocker")
  blocksReceived           Block[]                   @relation("BlockBlocked")
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  userDevices              UserDevice[]
  notificationSettings     NotificationSettings?
  reportsFiled             Report[]                  @relation("ReportReporter")
  reportsAgainst           Report[]                  @relation("ReportReported")
  verifications            Verification[]
  /// Selfie doğrulaması onaylandı (profilde rozet)
  verifiedAt               DateTime?
  /// Moderatör doğrulama istedi: yapılana kadar keşfette gizli (K11)
  verificationRequired     Boolean                   @default(false)
  /// İnceleme bekleniyor (ör. reşit olmayan şikayeti): keşfette gizli, moderatör kaldırır
  moderationHold           Boolean                   @default(false)

  @@index([status, lastActiveAt])
}

/// Refresh token ailesi. Token'ın kendisi değil SHA-256 özeti saklanır.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  refreshTokenHash  String    @unique
  /// Bir önceki token: tekrar gelirse token çalınmış sayılır ve oturum iptal edilir
  previousTokenHash String?   @unique
  deviceId          String?   @db.VarChar(128)
  userAgent         String?   @db.VarChar(256)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(32)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices UserDevice[]

  @@index([userId, revokedAt])
}

/// Rıza geçmişi (yalnızca ekleme). Güncel durum = türe göre en son kayıt.
model ConsentRecord {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  type        ConsentType
  granted     Boolean
  textVersion String      @db.VarChar(64)
  ipAddress   String?     @db.VarChar(64)
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

/// Silme / dışa aktarma talepleri. Hesap silinince userId null olur; kayıt uyum kanıtı olarak kalır.
model DataRequest {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String?           @db.Uuid
  type          DataRequestType
  status        DataRequestStatus @default(REQUESTED)
  requestedAt   DateTime          @default(now())
  scheduledFor  DateTime?
  completedAt   DateTime?
  failureReason String?           @db.VarChar(256)
  /// Dışa aktarma dosyasının nesne depolama anahtarı (7 gün indirilebilir)
  resultKey     String?           @db.VarChar(200)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status, scheduledFor])
  @@index([userId, type, status])
}

// ─── Faz 3: profil, fotoğraf, tercihler ───────────────────────

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  OTHER
}

enum RelationshipGoal {
  LONG_TERM
  LONG_TERM_OPEN_TO_SHORT
  SHORT_TERM_OPEN_TO_LONG
  SHORT_TERM
  NEW_FRIENDS
  NOT_SURE
}

enum Frequency {
  NEVER
  SOMETIMES
  OFTEN
  PREFER_NOT_TO_SAY
}

enum CommunicationStyle {
  TEXTER
  CALLER
  IN_PERSON
  MIXED
}

/// Fotoğrafın yaşam döngüsü: yükleme bekleniyor → işleniyor (EXIF temizleme + denetim) → sonuç.
enum PhotoStatus {
  AWAITING_UPLOAD
  PROCESSING
  APPROVED
  REJECTED
  NEEDS_REVIEW
  FAILED
}

model Profile {
  userId             String                                @id @db.Uuid
  displayName        String                                @db.VarChar(40)
  gender             Gender
  bio                String?                               @db.VarChar(500)
  jobTitle           String?                               @db.VarChar(60)
  heightCm           Int?
  relationshipGoal   RelationshipGoal?
  smoking            Frequency?
  drinking           Frequency?
  exercise           Frequency?
  wantsChildren      Boolean?
  communicationStyle CommunicationStyle?
  /// Kullanıcının seçtiği, profilde görünen yer adı (ör. "Kadıköy, İstanbul")
  cityName           String?                               @db.VarChar(80)
  /// Bulanıklaştırılmış konum (≈1 km ızgara + kullanıcıya özgü ≤500 m sapma). Tam koordinat saklanmaz.
  location           Unsupported("geography(Point,4326)")?
  locationUpdatedAt  DateTime?
  /// Kullanıcı kendini keşfetten gizleyebilir
  isDiscoverable     Boolean                               @default(true)
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isDiscoverable, gender])
  @@index([location], type: Gist, map: "Profile_location_gix")
}

model ProfilePhoto {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  /// Nesne depolamadaki anahtar (URL değil). İşlenmiş görsel bu anahtardadır.
  storageKey       String      @unique @db.VarChar(200)
  /// İstemcinin yüklediği ham dosyanın anahtarı; işlendikten sonra silinir.
  uploadKey        String?     @unique @db.VarChar(200)
  position         Int
  status           PhotoStatus @default(AWAITING_UPLOAD)
  width            Int?
  height           Int?
  /// Denetim sağlayıcısının etiketleri/skorları (yalnızca inceleme için)
  moderationLabels Json?
  createdAt        DateTime    @default(now())
  processedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, position])
  @@index([status, createdAt])
}

model UserInterest {
  userId     String @db.Uuid
  interestId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@id([userId, interestId])
  @@index([interestId])
}

/// Keşfet tercihleri. seekingGenders özel nitelikli veridir: yalnızca SPECIAL_CATEGORY_ORIENTATION
/// rızası güncelken dolu olabilir (K7). Satırın varlığı "tercih adımı tamamlandı" demektir.
model Preference {
  userId            String             @id @db.Uuid
  minAge            Int                @default(18)
  maxAge            Int                @default(60)
  maxDistanceKm     Int                @default(50)
  seekingGenders    Gender[]
  relationshipGoals RelationshipGoal[]
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Faz 4: keşfet, eşleşme, engelleme ───────────────────────

enum MatchStatus {
  ACTIVE
  UNMATCHED
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  targetId  String   @db.Uuid
  createdAt DateTime @default(now())

  actor  User @relation("LikeActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User @relation("LikeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  /// Aynı kişiyi iki kez beğenmek imkânsız; istek idempotenttir.
  @@unique([actorId, targetId])
  @@index([targetId, createdAt])
}

/// "Geç". expiresAt sonrası aday yeniden gösterilebilir (açık karar #4: 30 gün).
model Pass {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  targetId  String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  actor  User @relation("PassActor", fields: [actorId], references: [id], onDelete: Cascade)
  target User @relation("PassTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetId])
  @@index([actorId, expiresAt])
}

/// Sıralı çift: userAId < userBId (CHECK, ham SQL). Aynı çift için tek satır (yön bağımsız).
model Match {
  id            String      @id @default(uuid()) @db.Uuid
  userAId       String      @db.Uuid
  userBId       String      @db.Uuid
  status        MatchStatus @default(ACTIVE)
  unmatchedById String?     @db.Uuid
  unmatchedAt   DateTime?
  createdAt     DateTime    @default(now())

  userA        User          @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId])
  @@index([userAId, status, createdAt])
  @@index([userBId, status, createdAt])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  /// İki yönlü filtre için
  @@index([blockedId])
}

// ─── Faz 5: sohbet ve bildirimler ─────────────────────────────

enum MessageType {
  TEXT
  SYSTEM
}

enum Platform {
  IOS
  ANDROID
}

/// Eşleşmeden doğan 1:1 sohbet. Eşleşme bitince katılımcılar ayrılmış sayılır (leftAt).
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  matchId       String    @unique @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  match        Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

/// Sohbete erişimin tek kaynağı: kullanıcı yalnızca leftAt boş bir satırı varsa erişir.
model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  /// Bu ana kadarki mesajlar okundu sayılır (okunmamış sayısı ve "görüldü" için).
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  /// İstemci üretir (UUID): ağ hatasında tekrar gönderim aynı mesajı iki kez oluşturmaz.
  id             String      @id @db.Uuid
  conversationId String      @db.Uuid
  /// SYSTEM mesajlarında null
  senderId       String?     @db.Uuid
  type           MessageType @default(TEXT)
  body           String      @db.VarChar(2000)
  /// İletişim bilgisi / bağlantı içeriyor: alıcıya dolandırıcılık uyarısı gösterilir
  flagged        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  /// Gönderen sildi: metin boşaltılır, satır sıralama için kalır.
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
}

/// Push bildirimi alacak cihaz. Oturuma bağlıdır: oturum kapanınca cihaz kaydı silinir
/// (çıkış yapılmış telefona bildirim gitmez).
model UserDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  sessionId  String?   @db.Uuid
  platform   Platform
  /// Yerel FCM (Android) veya APNs (iOS) token'ı
  pushToken  String    @unique @db.VarChar(512)
  appVersion String?   @db.VarChar(32)
  locale     String?   @db.VarChar(16)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Sağlayıcı token'ı geçersiz dedi; bu cihaza gönderilmez.
  disabledAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

model NotificationSettings {
  userId     String   @id @db.Uuid
  newMatch   Boolean  @default(true)
  newMessage Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Faz 6: güvenlik, moderasyon, yönetim ─────────────────────

enum ReportReason {
  UNDERAGE
  NUDITY_SEXUAL
  HARASSMENT
  HATE
  SCAM_SPAM
  FAKE_PROFILE
  VIOLENCE_THREAT
  OFFLINE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTION_TAKEN
  DISMISSED
}

enum ReportTargetType {
  PROFILE
  PHOTO
  MESSAGE
}

enum AdminRole {
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Şikayet. Taraflardan biri hesabını silse de kanıt inceleme ve yasal süre boyunca korunur.
model Report {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String?          @db.Uuid
  reportedUserId   String?          @db.Uuid
  reason           ReportReason
  targetType       ReportTargetType
  /// Fotoğraf veya mesaj kimliği (PROFILE için boş)
  targetId         String?          @db.Uuid
  comment          String?          @db.VarChar(1000)
  /// Şikayet anındaki kanıt (profil alanları, mesaj ve bağlamı, fotoğraf kopyalarının anahtarları)
  evidence         Json
  status           ReportStatus     @default(OPEN)
  /// Yüksek = önce (UNDERAGE ve tehdit en üstte)
  priority         Int
  handledByAdminId String?          @db.Uuid
  resolutionNote   String?          @db.VarChar(1000)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  /// Bu tarihten sonra kanıt (ve kopyalanan medya) silinir
  evidencePurgeAt  DateTime?

  reporter     User?      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User?      @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  handledBy    AdminUser? @relation(fields: [handledByAdminId], references: [id], onDelete: SetNull)

  @@index([status, priority(sort: Desc), createdAt])
  @@index([reportedUserId, status])
  @@index([reporterId, reportedUserId, status])
  @@index([evidencePurgeAt])
}

model Verification {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  status       VerificationStatus @default(PENDING)
  /// İşlenmiş selfie (EXIF temizlenmiş). Karardan 30 gün sonra silinir.
  selfieKey    String?            @db.VarChar(200)
  uploadKey    String?            @db.VarChar(200)
  submittedAt  DateTime?
  reviewedById String?            @db.Uuid
  reviewedAt   DateTime?
  note         String?            @db.VarChar(500)
  createdAt    DateTime           @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, createdAt])
}

model AdminUser {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Küçük harfe çevrilmiş
  email               String    @unique @db.VarChar(254)
  /// argon2id (Node yerleşik crypto.argon2), "$argon2id$..." biçiminde
  passwordHash        String
  /// AES-256-GCM ile şifrelenmiş TOTP gizli anahtarı
  totpSecretEncrypted Bytes
  role                AdminRole @default(MODERATOR)
  isActive            Boolean   @default(true)
  failedLogins        Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())

  sessions              AdminSession[]
  auditLogs             AuditLog[]
  reportsHandled        Report[]
  verificationsReviewed Verification[]
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(64)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
}

/// Yönetici işlemlerinin denetim kaydı. Yalnızca ekleme; hassas veri içermez.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @db.Uuid
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([adminId, createdAt])
  @@index([createdAt])
}

/// 5651 trafik/erişim kaydı. FK yok: kullanıcı silinse de yasal süre boyunca kalır. Yalnızca ekleme.
model AccessLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @db.Uuid
  ipAddress String   @db.VarChar(64)
  port      Int?
  action    String   @db.VarChar(96)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
